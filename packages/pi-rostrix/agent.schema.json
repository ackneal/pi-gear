{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RostrixAgent",
  "description": "JSON Schema for Rostrix Agent definitions",
  "type": "object",
  "required": [
    "id",
    "label",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this agent (e.g. 'worker' or 'gear:worker')"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display label"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Description for the model when selecting an agent"
    },
    "extends": {
      "type": "string",
      "minLength": 1,
      "description": "Parent agent ID for inheritance"
    },
    "prompt": {
      "type": "object",
      "properties": {
        "systemPrompt": {
          "type": "string",
          "description": "Base system prompt or prefix"
        },
        "appendPrompt": {
          "type": "string",
          "description": "Appended system instructions"
        },
        "guidelines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional rules appended to prompt guidelines"
        },
        "inheritSystemPrompt": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "project",
            "all"
          ]
        },
        "inheritAppendSystemPrompt": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "project",
            "all"
          ]
        }
      }
    },
    "contextFiles": {
      "type": "object",
      "properties": {
        "inherit": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "project",
            "all"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional context file or directory paths (AGENTS.md / CLAUDE.md) to load in the subagent"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Context file or directory paths to exclude from inherited or explicit paths"
        }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowlist of tool names or wildcard patterns"
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Denylist of tool names or wildcard patterns (takes precedence over allow)"
        }
      }
    },
    "mcpServers": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            },
            "cwd": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "headers": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            },
            "timeout": {
              "type": "number",
              "minimum": 0
            },
            "exposure": {
              "type": "string",
              "enum": [
                "direct",
                "model-only",
                "codemode",
                "deferred",
                "hidden"
              ]
            },
            "toolExposure": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "model-only",
                    "codemode",
                    "deferred",
                    "hidden"
                  ]
                }
              }
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "inherit": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "all"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional skill file or directory paths to load in the subagent"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Skill file or directory paths to exclude from inherited or explicit paths"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "promptTemplates": {
      "type": "object",
      "properties": {
        "inherit": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "all"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional prompt template file or directory paths to load in the subagent"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Prompt template file or directory paths to exclude from inherited or explicit paths"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "preferred": {
          "type": "string",
          "description": "Preferred model identifier (e.g. anthropic/claude-sonnet-4-5)"
        },
        "fallback": {
          "type": "string",
          "description": "Fallback model identifier"
        }
      }
    },
    "subagents": {
      "type": "object",
      "properties": {
        "allowedAgents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Agents this agent is permitted to delegate to"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum nested delegation depth (default 2)"
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum active tasks for this agent ID (default 2)"
        }
      }
    },
    "supervision": {
      "type": "object",
      "properties": {
        "wakeOn": {
          "description": "Events that wake the parent. Inherited triggers are combined; no resolved triggers disables automatic wake-ups. Results remain queryable. needs_input is reserved and is not emitted by the current runtime.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "completed"
              },
              {
                "type": "string",
                "const": "failed"
              },
              {
                "type": "string",
                "const": "stalled"
              },
              {
                "type": "string",
                "const": "needs_input"
              }
            ]
          }
        },
        "reviewIntervalSeconds": {
          "type": "number",
          "minimum": 1
        },
        "maxDurationSeconds": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "inherit": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "all"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional extension file or directory paths to load in the subagent"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Extension file or directory paths to exclude from inherited or explicit paths"
        }
      }
    }
  }
}
