{
  "name": "pi-rostrix",
  "version": "0.1.0",
  "description": "Rostrix: Agent Management, Composition, Delegation & Supervision System for Pi.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-agent",
    "rostrix",
    "agent",
    "agent-profile",
    "delegation",
    "supervision",
    "subagents",
    "ai-agent"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-timeout=30000 tests/**/*.test.ts"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "@earendil-works/pi-tui": ">=1.0.0 <2.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "typebox": "1.3.13",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
