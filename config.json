{
  "version": 1,
  "filesystem": {
    "workspaceDefault": "read-write",
    "outsideWorkspaceDefault": "ask",
    "rules": [
      {
        "path": "**/.env",
        "access": "deny"
      },
      {
        "path": "**/.env.*",
        "access": "deny"
      },
      {
        "path": "**/*.pem",
        "access": "deny"
      },
      {
        "path": "**/*.key",
        "access": "deny"
      },
      {
        "path": "~/.ssh/**",
        "access": "deny"
      },
      {
        "path": "~/.aws/**",
        "access": "deny"
      },
      {
        "path": "~/.gnupg/**",
        "access": "deny"
      },
      {
        "path": "~/.kube/**",
        "access": "deny"
      }
    ]
  },
  "network": {
    "defaultAccess": "ask",
    "rules": []
  }
}
