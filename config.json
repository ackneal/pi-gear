{
  "version": 1,
  "filesystem": {
    "rules": [
      {
        "path": "**/.env",
        "access": "deny"
      },
      {
        "path": "**/.env.*",
        "access": "deny"
      },
      {
        "path": "**/*.pem",
        "access": "deny"
      },
      {
        "path": "**/*.key",
        "access": "deny"
      },
      {
        "path": "~/.ssh",
        "access": "deny"
      },
      {
        "path": "~/.aws",
        "access": "deny"
      },
      {
        "path": "~/.gnupg",
        "access": "deny"
      },
      {
        "path": "~/.kube",
        "access": "deny"
      }
    ]
  },
  "network": {
    "rules": [
      {
        "host": "github.com",
        "access": "allow"
      },
      {
        "host": "*.github.com",
        "access": "allow"
      },
      {
        "host": "*.githubusercontent.com",
        "access": "allow"
      }
    ]
  }
}
