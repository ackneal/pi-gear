{
  "$schema": "https://raw.githubusercontent.com/ackneal/pi-gear/main/config.schema.json",
  "version": 1,
  "sandbox": {
    "network": {
      "strictAllowlist": false,
      "rules": [
        {
          "host": "github.com",
          "access": "allow"
        },
        {
          "host": "*.github.com",
          "access": "allow"
        },
        {
          "host": "*.githubusercontent.com",
          "access": "allow"
        }
      ]
    }
  },
  "lsp": {
    "servers": []
  },
  "filesystem": {
    "rules": [
      {
        "path": "**/.env",
        "access": "deny"
      },
      {
        "path": "**/.env.*",
        "access": "deny"
      },
      {
        "path": "**/*.pem",
        "access": "deny"
      },
      {
        "path": "**/*.key",
        "access": "deny"
      },
      {
        "path": "~/.ssh",
        "access": "deny"
      },
      {
        "path": "~/.aws",
        "access": "deny"
      },
      {
        "path": "~/.gnupg",
        "access": "deny"
      },
      {
        "path": "~/.kube",
        "access": "deny"
      }
    ]
  }
}
