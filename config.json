{
  "$schema": "https://raw.githubusercontent.com/ackneal/pi-gear/main/config.schema.json",
  "version": 1,
  "sandbox": {
    "enabled": true,
    "network": {
      "strictAllowlist": false,
      "rules": [
        {
          "host": "github.com",
          "access": "allow"
        },
        {
          "host": "*.github.com",
          "access": "allow"
        },
        {
          "host": "*.githubusercontent.com",
          "access": "allow"
        }
      ]
    }
  },
  "lsp": {
    "idleTimeoutMinutes": 15,
    "servers": [
      {
        "extensions": [
          ".ts",
          ".tsx",
          ".js",
          ".jsx"
        ],
        "languageIds": {
          ".ts": "typescript",
          ".tsx": "typescriptreact",
          ".js": "javascript",
          ".jsx": "javascriptreact"
        },
        "command": [
          "tsc",
          "--lsp",
          "--stdio"
        ]
      },
      {
        "extensions": [
          ".go"
        ],
        "languageIds": {
          ".go": "go"
        },
        "command": [
          "gopls"
        ]
      },
      {
        "extensions": [
          ".rs"
        ],
        "languageIds": {
          ".rs": "rust"
        },
        "command": [
          "rust-analyzer"
        ]
      },
      {
        "extensions": [
          ".py",
          ".pyi"
        ],
        "languageIds": {
          ".py": "python",
          ".pyi": "python"
        },
        "command": [
          "basedpyright-langserver",
          "--stdio"
        ]
      }
    ]
  },
  "filesystem": {
    "rules": [
      {
        "path": "**/.env",
        "access": "deny"
      },
      {
        "path": "**/.env.*",
        "access": "deny"
      },
      {
        "path": "**/*.pem",
        "access": "deny"
      },
      {
        "path": "**/*.key",
        "access": "deny"
      },
      {
        "path": "~/.ssh",
        "access": "deny"
      },
      {
        "path": "~/.aws",
        "access": "deny"
      },
      {
        "path": "~/.gnupg",
        "access": "deny"
      },
      {
        "path": "~/.kube",
        "access": "deny"
      }
    ]
  }
}
