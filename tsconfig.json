{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["index.ts", "commands/**/*.ts", "context/**/*.ts", "config/**/*.ts", "execution/**/*.ts", "capabilities/**/*.ts", "lifecycle/**/*.ts", "subagents/**/*.ts", "ui/**/*.ts", "workspace/**/*.ts"]
}
